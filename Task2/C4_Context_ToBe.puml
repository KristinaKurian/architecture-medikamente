@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()

title Медикаменте — целевая архитектура (C4 System Context, Privacy by Design)

Person_Ext(patient, "Пациент", "Личный кабинет: запись, свои документы и оплата")
Person(reception, "Ресепшен", "Записи, договоры, напоминания")
Person(doctor, "Врач", "Ведение медкарт, назначения, анализы")
Person(finance, "Кассир / бухгалтер", "Приём и учёт платежей")
Person(warehouse, "Сотрудник склада", "ТМЦ и закупки")
Person(analyst, "Аналитик", "Отчёты, BI и ML")

Enterprise_Boundary(company, "Медикаменте — целевое состояние") {
    System_Boundary(operations, "Рабочие системы") {
        System(med, "Единая медицинская платформа", "Портал и мобильное приложение; пациенты, запись, медкарты, договоры, CRM и интеграции")
        System(accounting, "1С:Бухгалтерия", "Бухгалтерский учёт и платежи; защищённый доступ")
        System(inventory, "1С:Торговля и склад", "Учёт ТМЦ и закупок; защищённый доступ")
        System(kkm, "ККМ", "Приём оплаты и формирование чека")
    }

    System_Boundary(privacy_zone, "Общие механизмы Privacy by Design [НОВОЕ]") {
        System(iam, "IAM и контроль доступа", "SSO/MFA, роли и атрибуты; проверка пациента, цели и филиала")
        System(catalog, "Каталог и правила обработки данных", "Метки ПДн/врачебной тайны, источники, сроки хранения, основания и запросы на удаление")
        System(audit, "Аудит и мониторинг", "Журнал доступа и выгрузок, поиск аномалий, уведомления")
        System(kms, "Управление ключами", "Ключи шифрования медицинских данных и резервных копий")
    }

    System_Boundary(data_zone, "Защищённый аналитический слой [НОВОЕ]") {
        System(prep, "Подготовка и обезличивание", "Контроль полей, проверка цели, наследование меток, обезличивание")
        System(lake, "Озеро данных", "Допущенные обезличенные данные и агрегаты; контроль доступа")
        System(bi, "BI / ML", "Отчёты и модели только на разрешённых наборах данных")
    }
}

System_Ext(lab, "Внешняя лаборатория", "Обмен направлениями и результатами через API [будущая интеграция]")
System_Ext(notify, "Провайдер уведомлений", "Сообщения о записи без диагнозов [будущая интеграция]")

Rel(patient, med, "Записывается и смотрит только свои документы", "HTTPS")
Rel(reception, med, "Управляет записями и договорами", "HTTPS")
Rel(doctor, med, "Работает с картами своих пациентов", "HTTPS")
Rel(finance, accounting, "Ведёт учёт платежей", "Рабочее место")
Rel(finance, kkm, "Принимает оплату")
Rel(warehouse, inventory, "Учитывает ТМЦ")
Rel(analyst, bi, "Строит отчёты и модели")

Rel(med, iam, "Запрашивает решение о доступе к конкретным данным", "RBAC / ABAC")
Rel(med, catalog, "Использует метки, цели и сроки хранения")
Rel(iam, catalog, "Учитывает классификацию и правила обработки")
Rel(med, audit, "Передаёт события чтения, изменения и выгрузки")
Rel(med, kms, "Использует ключи для шифрования данных")
Rel(iam, audit, "Фиксирует разрешения и отказы")

Rel(med, lab, "Передаёт необходимый минимум данных", "Защищённый API")
Rel(lab, med, "Передаёт результаты анализов", "Защищённый API")
Rel(med, notify, "Направляет минимальные данные для напоминания", "API")
Rel(med, accounting, "Передаёт платежные данные без медтекстов", "Защищённая интеграция")
Rel(kkm, accounting, "Передаёт операции оплаты", "Защищённый канал")
Rel(inventory, accounting, "Передаёт сведения о движении ТМЦ", "Защищённая интеграция")

Rel(med, prep, "Передаёт данные только через контролируемую выгрузку")
Rel(accounting, prep, "Передаёт разрешённые финансовые показатели")
Rel(prep, catalog, "Проверяет метки, цели, происхождение данных")
Rel(prep, iam, "Проверяет право на выгрузку")
Rel(prep, audit, "Журналирует обработку и экспорт")
Rel(prep, lake, "Загружает обезличенные данные / агрегаты")
Rel(lake, bi, "Предоставляет проверенные наборы")
Rel(bi, iam, "Проверяет доступ аналитика")

SHOW_LEGEND()
@enduml
