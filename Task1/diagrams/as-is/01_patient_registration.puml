@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 14
skinparam ArrowColor #425466
skinparam actorBorderColor #334155
skinparam rectangleBorderColor #64748B
skinparam databaseBorderColor #7C3AED
skinparam wrapWidth 180
title DFD 1 As-Is: запись пациента и договоры

actor "Пациент" as patient
actor "Ресепшен" as rec
actor "Медицинский\nспециалист" as doctor
rectangle "P1. Получить данные\nи оформить договор" as p1 #E2E8F0
rectangle "P2. Внести запись\nна приём" as p2 #E2E8F0
rectangle "P3. Найти запись\nи данные пациента" as p3 #E2E8F0
database "D1. Excel:\nпациенты, журнал приёма" as excel #FEF3C7
database "D2. Общий диск:\nдоговоры, JPG/PDF" as file #FEF3C7
patient --> p1 : ФИО, ДР, телефон, email;\nдоп. анкета (если заполнена)
rec --> p1 : Ручной ввод/сканирование
p1 --> file : Сохранить договор и скан
p1 --> p2 : Данные пациента и услуги
p2 --> excel : Записать дату, врача, пациента
rec --> p3 : Запрос записи или данных
excel --> p3 : Прочитать журнал
file --> p3 : Прочитать договор
p3 --> doctor : Сведения о приёме
p3 --> rec : Показать данные

@enduml
