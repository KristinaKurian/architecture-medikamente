        <mxCell id="card-infra" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF5FD;strokeColor=#2E6CAC;strokeWidth=2.5;fontColor=#1C2B40;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=14;overflow=fill;" value="&lt;div style=&quot;font-size:23px&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ИНФРАСТРУКТУРА&lt;/b&gt; &lt;span style=&quot;color:#2E6CAC;font-size:18px&quot;&gt; · P0&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px&quot;&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Один физический сервер&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Файловая 1С и общий диск&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Нагрузка на диск при росте ×5&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Резервирование не описано&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="238" width="440" x="80" y="180" as="geometry" />
        </mxCell>
        <mxCell id="card-data" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F0FB;strokeColor=#7964B2;strokeWidth=2.5;fontColor=#1C2B40;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=14;overflow=fill;" value="&lt;div style=&quot;font-size:23px&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ДАННЫЕ И МИГРАЦИЯ&lt;/b&gt; &lt;span style=&quot;color:#7964B2;font-size:18px&quot;&gt; · P0&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px&quot;&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Excel, PDF/JPG, ручная обработка&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Возможные дубли и ошибки связей&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Долгий импорт исторических данных&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.5&quot;&gt;• Импорт конкурирует с приёмом&lt;/div&gt;&lt;/div&gt;" vertex="1">
